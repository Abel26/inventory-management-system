# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and update the values for your production environment
# ============================================

# --- Application ---
APP_NAME="Inventory Management System"
APP_ENV=production                    # ❌ CRITICAL: Must be 'production'
APP_DEBUG=false                      # ❌ CRITICAL: Must be 'false' to prevent stack trace exposure
APP_URL=https://yourdomain.com       # ✅ CRITICAL: Must use HTTPS
APP_KEY=                            # ❌ CRITICAL: Generate new key: php artisan key:generate

# --- Locale ---
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# --- Maintenance ---
APP_MAINTENANCE_DRIVER=file

# --- PHP Settings ---
BCRYPT_ROUNDS=12

# --- Logging ---
LOG_CHANNEL=daily                    # ✅ Use daily logs for production
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning                    # ❌ Change from 'debug' to 'warning' or 'error'

# --- Database ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=production_db            # ✅ Use separate database for production
DB_USERNAME=production_user          # ✅ Use separate user with limited privileges
DB_PASSWORD=<strong_password>        # ❌ Use strong password

# --- Session Security (CRITICAL) ---
SESSION_DRIVER=database              # ✅ Database is recommended for production
SESSION_LIFETIME=120
SESSION_ENCRYPT=true               # ❌ Must be 'true'
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true           # ❌ Must be 'true' (requires HTTPS)
SESSION_HTTP_ONLY=true             # ✅ Keep it true
SESSION_SAME_SITE=strict           # ❌ Must be 'strict' (changed from 'lax')

# --- Broadcast ---
BROADCAST_CONNECTION=log

# --- Filesystem ---
FILESYSTEM_DISK=public               # ✅ Store files in storage/app/public, NOT in public/

# --- Queue ---
QUEUE_CONNECTION=redis                # ✅ Redis is recommended for production

# --- Cache ---
CACHE_STORE=redis                    # ✅ Redis is recommended for production
# CACHE_PREFIX=

# --- Redis ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=<strong_password>      # ❌ Use strong password
REDIS_PORT=6379

# --- Memcached ---
MEMCACHED_HOST=127.0.0.1

# --- Mail ---
MAIL_MAILER=smtp                     # ✅ Use real mail service
MAIL_SCHEME=tls                     # ✅ Use TLS
MAIL_HOST=smtp.provider.com
MAIL_PORT=587
MAIL_USERNAME=your_email@domain.com
MAIL_PASSWORD=<mail_password>          # ❌ Use strong password
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS (Optional) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Security Configuration ---
# Add these custom variables for enhanced security
CSP_ENABLED=true                     # ✅ Enable Content Security Policy
CSP_REPORT_ONLY=false               # ✅ Set to false for production (enforce, don't just report)
ALLOWED_ORIGINS=https://yourdomain.com  # ✅ Restrict CORS origins

# --- Frontend ---
VITE_APP_NAME="${APP_NAME}"

# ============================================
# SECURITY CHECKLIST
# ============================================
# Before deploying to production, ensure:
#
# [ ] APP_ENV is set to 'production'
# [ ] APP_DEBUG is set to 'false'
# [ ] APP_KEY is generated and kept secret
# [ ] APP_URL uses HTTPS
# [ ] SESSION_SECURE_COOKIE is set to 'true'
# [ ] SESSION_HTTP_ONLY is set to 'true'
# [ ] SESSION_SAME_SITE is set to 'strict'
# [ ] SESSION_ENCRYPT is set to 'true'
# [ ] DB_PASSWORD is a strong, unique password
# [ ] REDIS_PASSWORD is a strong, unique password
# [ ] MAIL_PASSWORD is a strong, unique password
# [ ] LOG_LEVEL is set to 'warning' or 'error'
# [ ] Database user has only necessary privileges
# [ ] HTTPS is enabled on the server
# [ ] SSL certificate is valid and up-to-date
# [ ] Storage directory has correct permissions (755 for dirs, 644 for files)
# [ ] public/index.php is not writable by web server (or strictly monitored)
# [ ] Directory listing is disabled
# [ ] Composer and Node modules are removed from production
# [ ] .env file is not accessible from web
# [ ] Backup encryption is enabled
# [ ] Regular backups are configured
# [ ] Error monitoring is configured (e.g., Sentry, Bugsnag)
# [ ] Uptime monitoring is configured
# ============================================
